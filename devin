#!/usr/bin/env bash
# Devin AGI 4.0 — Universal launcher
#
# Usage:
#   ./devin                        Interactive terminal (Shift+Tab switches mode)
#   ./devin "message"              One message, then exit (Devin decides: answer or act)
#   ./devin --do "task"            Carry out one task with the mouse and keyboard
#   ./devin --chat "message"       Answer only, never touch the computer
#   ./devin --doctor               Check screen capture, input control and the model
#   ./devin --model NAME           Use this Ollama model
#   ./devin --setup                Install Python packages and check Linux system packages
#   ./devin --test                 Run the test suite
#   ./devin --load-all             Import every module in the repo before the terminal
#   ./devin --status               Show module load status
#   ./devin --caps                 Capability summary per directory
#   ./devin --no-agent             Load modules only
#   ./devin --version              Show version
#   ./devin --help                 Show this help
#
# Environment variables (set in .env, never here):
#   OLLAMA_BASE_URL       Ollama server (default http://localhost:11434)
#   OLLAMA_MODEL          model for conversation (default: the most capable installed one)
#   DEVIN_AGENT_MODEL     model that works the computer (default: an installed model that can see)
#   DEVIN_INPUT_BACKEND   gnome | ydotool | xdotool | pyautogui (default: automatic)
#   DEVIN_ALLOW_SHELL     1 lets Devin run commands directly; 0 = mouse and keyboard only
#   DEVIN_MAX_STEPS       most actions per task (default 40)
#   DEVIN_EYES            auto | always | never: when the screenshot itself goes to the model
#   DEVIN_TYPE_INTERVAL   seconds per key when typing (default 0.045, a person's pace)
#   DEVIN_TRACE           1 logs every prompt, reply and outcome (in $XDG_RUNTIME_DIR/devin/)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ── Load .env (export all vars) ───────────────────────────────────────────────────────────
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  source .env 2>/dev/null || true
  set +a
fi

# ── Set DISPLAY default on Linux if not already set ────────────────────────────────
if [ "$(uname -s)" = "Linux" ] && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  export DISPLAY=:0
fi

# ── Activate virtualenv if present ─────────────────────────────────────────────────────
for _VENV in venv .venv env; do
  if [ -f "$_VENV/bin/activate" ]; then
    # shellcheck disable=SC1090
    source "$_VENV/bin/activate" 2>/dev/null || true
    break
  fi
done

# ── Pick Python ──────────────────────────────────────────────────────────────────────────────
PYTHON="${PYTHON_CMD:-}"
if [ -z "$PYTHON" ]; then
  for _py in python3.12 python3.11 python3.10 python3.9 python3 python; do
    if command -v "$_py" >/dev/null 2>&1; then
      PYTHON="$_py"
      break
    fi
  done
fi
if [ -z "$PYTHON" ]; then
  echo "ERROR: Python 3 not found. Install Python 3.9+ first." >&2
  exit 1
fi

# ── Argument parsing ───────────────────────────────────────────────────────────────────────
case "${1:-}" in
  --help|-h)
    head -n 30 "$0" | grep '^#' | sed 's/^# \?//'
    exit 0
    ;;

  --version|-V)
    echo "Devin AGI v4.0.0"
    exit 0
    ;;

  --setup|--install-deps)
    echo "Installing dependencies..."
    "$PYTHON" -m pip install --upgrade pip
    if [ -f requirements.txt ]; then
      "$PYTHON" -m pip install -r requirements.txt
    fi
    if [ "$(uname -s)" = "Linux" ]; then
      # Desktop control needs a few system packages that pip cannot provide.
      MISSING=""
      for pair in ydotool:ydotool tesseract:tesseract-ocr xclip:xclip gdbus:libglib2.0-bin; do
        command -v "${pair%%:*}" >/dev/null 2>&1 || MISSING="$MISSING ${pair##*:}"
      done
      /usr/bin/python3 -c "import gi; gi.require_version('Atspi','2.0'); gi.require_version('Gst','1.0')" 2>/dev/null \
        || MISSING="$MISSING python3-gi gir1.2-atspi-2.0 gir1.2-gstreamer-1.0 gstreamer1.0-pipewire"
      if [ -n "$MISSING" ]; then
        echo ""
        echo "Linux system packages still missing. Install them with:"
        echo "  sudo apt install -y$MISSING"
      fi
      if command -v ydotool >/dev/null 2>&1 && [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.ydotool_socket" ]; then
        echo ""
        echo "ydotool is installed but its daemon is not running for you. Run once:"
        echo "  sudo usermod -aG input \"\$USER\"            # permanent, applies from your next login"
        echo "  sudo setfacl -m \"u:\$USER:rw\" /dev/uinput  # works right now"
        echo "  systemctl --user reset-failed ydotool; systemctl --user enable --now ydotool"
      fi
      echo ""
      echo "Check everything with:  ./devin --doctor"
    fi
    echo "Done."
    exit 0
    ;;

  --test)
    # Unit tests run against a fake desktop: they never move the real pointer.
    exec "$PYTHON" -m pytest tests/test_os_agent.py tests/test_computer_agent.py -q "${@:2}"
    ;;

  --status)
    exec "$PYTHON" main.py --status "${@:2}"
    ;;

  --caps)
    exec "$PYTHON" main.py --caps "${@:2}"
    ;;

  --no-agent)
    exec "$PYTHON" main.py --no-agent "${@:2}"
    ;;

  --voice)
    # Voice mode: export flag, then full module load + agent REPL
    export DEVIN_VOICE_MODE=1
    exec "$PYTHON" main.py --voice "${@:2}"
    ;;

  --provider)
    # Set provider and start REPL
    if [ -z "${2:-}" ]; then
      echo "ERROR: --provider requires an argument (claude|gemini|openai|hf|ollama|free)" >&2
      exit 1
    fi
    export DEVIN_PROVIDER="$2"
    exec "$PYTHON" main.py --provider "$2" "${@:3}"
    ;;

  --provider=*)
    # --provider=hf style
    PROV="${1#--provider=}"
    export DEVIN_PROVIDER="$PROV"
    exec "$PYTHON" main.py --provider "$PROV" "${@:2}"
    ;;

  *)
    # Default: full module load via main.py then agent.py REPL
    # This ensures EVERY capability module is loaded for every session.
    exec "$PYTHON" main.py "$@"
    ;;
esac
