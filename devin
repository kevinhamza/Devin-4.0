#!/usr/bin/env bash
# Devin AGI 4.0 — Universal launcher
# Always uses agent.py (the unified agentic CLI) — no TypeScript dependency.

set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Load .env
if [ -f .env ]; then
  set -a
  source .env 2>/dev/null || true
  set +a
fi

# Activate venv if present
if [ -d venv/bin ]; then
  source venv/bin/activate 2>/dev/null || true
fi

# Use agent.py as the primary entry point
exec python3 agent.py "$@"
