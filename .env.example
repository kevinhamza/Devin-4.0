# Devin-4.0 Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# At least ONE AI provider key is required.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# RECOMMENDED FREE OPTION ↓ Qwen3-235B / DeepSeek-V3 / Llama3.3 on HuggingFace

# HuggingFace (free tier — 1000s of models including Qwen3, DeepSeek-V3, Llama3)
# Get yours FREE at: https://huggingface.co/settings/tokens
HF_TOKEN=

# HuggingFace model to use (override default Qwen3-235B-A22B)
# Options: Qwen/Qwen3-235B-A22B | deepseek-ai/DeepSeek-V3-0324 |
#          Qwen/Qwen3-32B | meta-llama/Llama-3.3-70B-Instruct |
#          Qwen/Qwen2.5-Coder-32B-Instruct | deepseek-ai/DeepSeek-R1-Distill-Llama-70B
# HF_MODEL=Qwen/Qwen3-235B-A22B

# Google Gemini (free tier available)
# Get yours FREE at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude (paid)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT (paid)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Free Claude Code proxy (optional, no key needed) ──────────────────────────
# Routes Claude-style requests to free providers. Install: pip install free-claude-code
# Then start server: fcc-server
# FCC_BASE_URL=http://127.0.0.1:3000
# FCC_MODEL=claude-sonnet-4-5

# ── Display / GUI ─────────────────────────────────────────────────────────────
# Linux: set to your X display (usually :0 or :1)
# Leave unset on macOS/Windows — they auto-detect.
# DISPLAY=:0

# ── Voice ─────────────────────────────────────────────────────────────────────
# Language for speech recognition
VOICE_LANG=en-US

# ── Local Ollama (local LLM, no key required) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Memory ────────────────────────────────────────────────────────────────────
# Where to store persistent memory (SQLite database)
DEVIN_DB_PATH=~/.devin_memory.db

# ── Optional Integrations ─────────────────────────────────────────────────────

# Telegram bot (remote control via Telegram)
# Create a bot at: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord bot
# DISCORD_BOT_TOKEN=

# Slack
# SLACK_BOT_TOKEN=

# ── Cloud Providers ───────────────────────────────────────────────────────────

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Azure
# AZURE_SUBSCRIPTION_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# Google Cloud
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Security ──────────────────────────────────────────────────────────────────
# Set to 1 to enable authorized penetration testing tools (nmap, metasploit, etc.)
# Only enable when you have explicit authorization for the target systems.
AUTHORIZED_SECURITY=0
