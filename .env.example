# Devin-4.0 Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER hardcode any of these values in source files.

# =============================================================
# AI Provider Keys (set at least one; HF_TOKEN is free)
# =============================================================

# HuggingFace free-tier (recommended starting point)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Alias for HF_TOKEN (either works)
# HUGGINGFACE_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# Google Gemini
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Ollama (local inference)
# OLLAMA_BASE_URL=http://localhost:11434

# Free Claude Code (https://github.com/alishahryar1/free-claude-code)
# CLAUDE_SESSION_KEY=

# =============================================================
# Provider Control
# =============================================================

# Force a specific provider (overrides auto-selection)
# Values: claude | gemini | openai | huggingface | ollama | free
# DEVIN_PROVIDER=

# Force a specific model name
# DEVIN_MODEL=

# =============================================================
# Memory
# =============================================================

# Path to SQLite memory database
# DEVIN_DB_PATH=~/.devin/memory.db

# =============================================================
# OS Agent
# =============================================================

# Set to 0 to disable display/GUI features (headless mode)
# DEVIN_HAS_DISPLAY=1

# =============================================================
# Voice Engine
# =============================================================

# TTS backend: auto | pyttsx3 | gtts | system
# DEVIN_TTS_BACKEND=auto

# STT backend: auto | whisper | google | none
# DEVIN_STT_BACKEND=auto

# Language code for voice (BCP-47)
# DEVIN_VOICE_LANG=en

# =============================================================
# Browser Agent
# =============================================================

# Browser backend: auto | playwright | selenium
# DEVIN_BROWSER_BACKEND=auto

# Run browser headless (1=headless, 0=visible)
# DEVIN_BROWSER_HEADLESS=0

# Browser type: chromium | firefox | webkit
# DEVIN_BROWSER_TYPE=chromium

# =============================================================
# System Monitor
# =============================================================

# Alert threshold percentages
# DEVIN_CPU_ALERT=85
# DEVIN_MEMORY_ALERT=90
# DEVIN_DISK_ALERT=90

# =============================================================
# Security
# =============================================================

# Enable authorized security tools (requires explicit confirmation per task)
# DEVIN_SECURITY_TOOLS=0
