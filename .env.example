# Devin AGI Environment Variables

# --- Core AI Provider API Keys ---
# Required for the AIAgent to function. Tool-selection (the actual agent
# loop, not just chat) prefers Claude, then OpenAI, then falls back to
# Gemini -- so at least one of these three must be set.
#
# FREE TIER: GEMINI_API_KEY alone is enough to run the full assistant
# (OS control, tool use, everything) at zero cost. Get a free key with no
# billing/credit-card setup at https://aistudio.google.com/apikey -- the
# free tier has daily rate limits but no charge.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
PERPLEXITY_API_KEY="YOUR_PERPLEXITY_API_KEY_HERE"

# --- Threat Intelligence API Keys ---
# Required for the ThreatIntel modules.
VIRUSTOTAL_API_KEY="YOUR_VIRUSTOTAL_API_KEY_HERE"

# --- Cloud Provider Credentials ---
# The CloudFacade uses the standard SDK environment variables.
# Ensure these are set if you intend to use the cloud modules.
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
# AWS_DEFAULT_REGION="us-east-1"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/gcp-credentials.json"

# --- Social Media (all optional -- SocialMediaManager only enables the
# platforms whose credentials are actually set) ---
# TWITTER_BEARER_TOKEN="YOUR_TWITTER_BEARER_TOKEN"
# REDDIT_CLIENT_ID="YOUR_REDDIT_CLIENT_ID"
# REDDIT_CLIENT_SECRET="YOUR_REDDIT_CLIENT_SECRET"
# FACEBOOK_ACCESS_TOKEN="YOUR_FACEBOOK_PAGE_ACCESS_TOKEN"
# INSTAGRAM_ACCESS_TOKEN="YOUR_INSTAGRAM_GRAPH_API_ACCESS_TOKEN"
# INSTAGRAM_USER_ID="YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID"
# LINKEDIN_ACCESS_TOKEN="YOUR_LINKEDIN_ACCESS_TOKEN"
# LINKEDIN_MEMBER_URN="urn:li:person:YOUR_MEMBER_ID"

# --- Multi-Channel Messaging (all optional -- MessagingGateway only
# registers the channels whose credentials are actually set) ---
# TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
# DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
# SLACK_BOT_TOKEN="xoxb-YOUR_SLACK_BOT_TOKEN"
# SLACK_APP_TOKEN="xapp-YOUR_SLACK_APP_TOKEN"

# --- Other Configurations ---
# The default serial port for the robotics controller.
ROBOT_SERIAL_PORT="/dev/ttyACM0"


# --- AGI Operational Mode ---
# Set to 'live' to use real, paid APIs.
# Set to 'mock' to use the free, offline mock AI for development and testing.
DEVIN_MODE=mock
