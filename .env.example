# Devin AGI Environment Variables

# --- Core AI Provider API Keys ---
# Required for the AIAgent to function. If ANTHROPIC_API_KEY is set, Claude is
# preferred for tool-selection reasoning; otherwise it falls back to OpenAI.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
PERPLEXITY_API_KEY="YOUR_PERPLEXITY_API_KEY_HERE"

# --- Threat Intelligence API Keys ---
# Required for the ThreatIntel modules.
VIRUSTOTAL_API_KEY="YOUR_VIRUSTOTAL_API_KEY_HERE"

# --- Cloud Provider Credentials ---
# The CloudFacade uses the standard SDK environment variables.
# Ensure these are set if you intend to use the cloud modules.
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
# AWS_DEFAULT_REGION="us-east-1"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/gcp-credentials.json"

# --- Other Configurations ---
# The default serial port for the robotics controller.
ROBOT_SERIAL_PORT="/dev/ttyACM0"


# --- AGI Operational Mode ---
# Set to 'live' to use real, paid APIs.
# Set to 'mock' to use the free, offline mock AI for development and testing.
DEVIN_MODE=mock
