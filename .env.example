# Devin-4.0 Configuration
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git — it contains secrets.
#
# At least ONE AI provider key is required.

# ── AI Provider Keys ──────────────────────────────────────────────────────────

# Google Gemini (free tier available)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# HuggingFace (free tier — LLaMA 3.1, Mixtral, Qwen, and more)
# Get yours at: https://huggingface.co/settings/tokens
# Supports: meta-llama/Meta-Llama-3.1-70B-Instruct, Qwen/Qwen2.5-72B-Instruct,
#           mistralai/Mixtral-8x7B-Instruct-v0.1, microsoft/Phi-3.5-mini-instruct
HF_TOKEN=

# ── Display / GUI ─────────────────────────────────────────────────────────────

# Linux: set to your X display (usually :0 or :1)
# Leave unset on macOS/Windows — they auto-detect.
# DISPLAY=:0

# ── Optional Integrations ─────────────────────────────────────────────────────

# Telegram bot (for remote control via Telegram)
# Create a bot at: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=

# Discord bot
# DISCORD_BOT_TOKEN=

# Slack
# SLACK_BOT_TOKEN=

# ── Cloud Providers ───────────────────────────────────────────────────────────

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Azure
# AZURE_SUBSCRIPTION_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# Google Cloud
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Devin Behavior ────────────────────────────────────────────────────────────

# Force a specific AI provider (claude|gemini|openai|huggingface)
# Leave blank for auto-selection based on available keys
# DEVIN_PROVIDER=huggingface

# HuggingFace model override (default: Qwen/Qwen2.5-72B-Instruct)
# HF_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Claude model override
# CLAUDE_MODEL=claude-opus-4-5

# Gemini model override
# GEMINI_MODEL=gemini-2.0-flash-exp

# Enable voice mode at startup (1=on, 0=off)
# DEVIN_VOICE_MODE=0

# Permission mode (auto_approve | manual)
# DEVIN_PERMISSION_MODE=manual

# ── Miscellaneous ─────────────────────────────────────────────────────────────

# Local Ollama endpoint (for local LLM via Ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# free-claude-code proxy (no API key needed — 54+ free providers)
# Install: curl -fsSL https://raw.githubusercontent.com/Alishahryar1/free-claude-code/main/scripts/install.sh | sh
# Run: fcc-server
# FCC_BASE_URL=http://localhost:8080
# FCC_PORT=8080
# FCC_MODEL=groq/llama-3.3-70b-versatile
